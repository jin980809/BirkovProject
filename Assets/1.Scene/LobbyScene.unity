    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "[\uC784\uC2DC] \uD14D\uC2A4\uD2B8 \uB0B4\uC6A9\uC740 \uCD94\uD6C4 \uBC14\uB014
